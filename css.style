
:root {
  --bg: #0b1120;
  --card: #151f32;
  --text: #f8fafc;
  --muted: #94a3b8;
  --accent: #38bdf8;
  --border: #263449;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
  font-family: Inter, system-ui, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
}

a { text-decoration: none; color: inherit; }

.container {
  width: min(1100px, 90%);
  margin: auto;
}

header {
  position: sticky;
  top: 0;
  background: rgba(11, 17, 32, .95);
  border-bottom: 1px solid var(--border);
  z-index: 10;
}

.navbar {
  min-height: 75px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 23px;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span, .eyebrow, .hero h1 span {
  color: var(--accent);
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 30px;
}

.nav-links a {
  color: var(--muted);
  transition: color .2s;
}

.nav-links a:hover { color: var(--accent); }

.menu-btn {
  display: none;
  background: none;
  border: 0;
  color: white;
  font-size: 26px;
  cursor: pointer;
}

.hero {
  min-height: 75vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.eyebrow {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 18px;
}

.hero h1 {
  font-size: clamp(38px, 6vw, 72px);
  line-height: 1.15;
  letter-spacing: -2px;
  margin-bottom: 25px;
}

.hero-desc, .section-desc {
  max-width: 650px;
  color: var(--muted);
  font-size: 17px;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: 32px;
}

.btn {
  display: inline-block;
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  transition: transform .2s;
}

.btn:hover { transform: translateY(-3px); }

.primary {
  background: #0284c7;
  color: white;
}

.secondary {
  border: 1px solid var(--border);
}

.section {
  padding: 95px 0;
  border-top: 1px solid var(--border);
}

.section h2 {
  font-size: clamp(30px, 4vw, 42px);
  margin-bottom: 20px;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.skills span {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 18px;
  color: #cbd5e1;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 35px;
}

.project-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 28px;
  transition: transform .25s, border-color .25s;
}

.project-card:hover {
  transform: translateY(-6px);
  border-color: var(--accent);
}

.project-icon {
  font-size: 32px;
  margin-bottom: 20px;
}

.project-card h3 {
  font-size: 21px;
  margin-bottom: 12px;
}

.project-card p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 20px;
}

.project-card small {
  display: block;
  color: var(--accent);
  margin-bottom: 20px;
}

.project-card a {
  font-weight: 600;
  font-size: 14px;
}

footer {
  padding: 30px;
  text-align: center;
  color: var(--muted);
  border-top: 1px solid var(--border);
  font-size: 14px;
}

@media (max-width: 768px) {
  .menu-btn { display: block; }

  .nav-links {
    display: none;
    position: absolute;
    top: 75px;
    left: 0;
    width: 100%;
    background: var(--bg);
    padding: 25px;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
  }

  .nav-links.active { display: flex; }

  .hero { min-height: 70vh; }

  .project-grid {
    grid-template-columns: 1fr;
  }

  .section { padding: 65px 0; }
}
